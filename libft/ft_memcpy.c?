#include <string.h>

void *ft_memcpy(void *dest, const void *src, size_t n)
{
	size_t i;
	i=0;
	if(dest=='\0'&& src=='\0')
		return(NULL);
	while(i<n)
	{
		dest[i]=src[i];
		i++;
	}
	return(dest);
}
