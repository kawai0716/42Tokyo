#include <string.h>

void	*ft_memchr(const void *s, int c, size_t n)
{
	size_t			i;
	unsigned char	*a;

	i = 0;
	a = s;
	while (i < n)
	{
		if (a[i] = c)
			return (a[i]);
		i++;
	}
	return (NULL);
}
