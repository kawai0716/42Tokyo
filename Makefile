# Makefile for Philosophers project

NAME = philosophers
CC = cc
CFLAGS = -Wall -Wextra -Werror -I./include/
RM = rm -f

SRC_DIR = src
SRCS = $(wildcard $(SRC_DIR)/*.c)
OBJS = $(SRCS:.c=.o)

all: $(NAME)

$(NAME): $(OBJS)
	$(CC) $(CFLAGS) -o $(NAME) $(OBJS)
	@echo""
	@echo "        |\\___/|"
	@echo "        )     ("
	@echo "       =\\     /="
	@echo "         )===( "
	@echo "        /     \\"
	@echo "        |     |"
	@echo "       /       \\"
	@echo "       \\       /"
	@echo "        \\__  _/"
	@echo "          ( ("
	@echo "           ) )"
	@echo "          (_("

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	$(RM) $(OBJS)

fclean: clean
	$(RM) $(NAME)

re: fclean all

.PHONY: all clean fclean re
sanitize: $(OBJ)
	$(CC) -g -fsanitize=address $(OBJ) -o $(NAME)

echo:
	@echo $(OBJ)

1:
	./$(NAME) 1 800 200 200

2:
	./$(NAME) 5 800 200 200

3:
	./$(NAME) 5 800 200 200 7

4:
	./$(NAME) 4 410 200 200

5:
	./$(NAME) 4 310 200 100

6:
	./$(NAME) 10 800 200 200 7

7:
	./$(NAME) 200 420 200 200 7 | grep "is eating" | wc -l

ty:
	@echo "⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣀⣀⣤⣀⢠⡤⠤⠖⠒⠒⠒⠲⣆⠀⠀⠀⠀⣾⠋⠉⠉⠛⢷⠀⣴⠖⠒⠤⣄⠀⣀⡀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀"
